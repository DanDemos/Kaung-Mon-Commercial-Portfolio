# Next.js app env. Copy to `frontend/nextjs/.env`. Do not commit `.env`.

# Contact form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the form validates but cannot send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=a@gmail.com
CONTACT_FROM_EMAIL=Portfolio contact <onboarding@resend.dev>

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics beacon (Node backend). Omit to disable telemetry.
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8787
# Optional — must match backend ANALYTICS_INGEST_KEY when set
# NEXT_PUBLIC_ANALYTICS_KEY=
