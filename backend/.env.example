# Backend-only env. Copy to `backend/.env`. Do not commit `.env`.

DASHBOARD_PASSWORD=
# Local only — Railway sets PORT automatically
ANALYTICS_PORT=8787
# Comma-separated browser origins allowed to POST /v1/events (your Vercel URL + local)
ANALYTICS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174
# Optional write key (frontend must send the same as NEXT_PUBLIC_ANALYTICS_KEY)
# ANALYTICS_INGEST_KEY=
# Local default: backend/data/analytics.sqlite
# Railway volume: mount at /data and set:
# ANALYTICS_DB_PATH=/data/analytics.sqlite
