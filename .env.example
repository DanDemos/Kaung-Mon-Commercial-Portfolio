# Shared env for the whole repo (Next.js and any other apps/tools).
# Copy to `/.env` at the repo root. Do not commit `/.env`.

# Contact form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the form validates but cannot send.
RESEND_API_KEY=
# Inbox that receives portfolio messages
CONTACT_TO_EMAIL=a@gmail.com
# Must be a verified sender in Resend (domain or onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL=Portfolio contact <onboarding@resend.dev>

# Optional but recommended: Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Blocks automated form spam without a visible puzzle for most visitors.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
